{
  "name": "wfh-desktop-agent",
  "version": "1.1.9",
  "description": "Work From Home tracking desktop agent",
  "author": "Sasiru Liyanage",
  "homepage": "https://github.com/sasiruliyanage2004/WFH-Tracking",
  "main": "out/main.js",
  "scripts": {
    "clean": "rimraf out",
    "build:ts": "npm run clean && tsc",
    "start": "npm run build:ts && electron .",
    "build": "npm run build:ts && electron-builder --win",
    "release": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "axios": "^1.6.8",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^30.0.1",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.wfh.desktopagent",
    "productName": "WorkforceOS-Agent",
    "publish": [
      {
        "provider": "github",
        "owner": "sasiruliyanage2004",
        "repo": "WFH-Tracking"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "win-icon.ico",
      "artifactName": "WFH-Agent.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "win-icon.ico",
      "uninstallerIcon": "win-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "win-icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "WorkforceOS-Agent-Mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Business",
      "artifactName": "WorkforceOS-Agent.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "react-build/**/*",
      "splash.html",
      "win-icon.ico",
      "activity-monitor.ps1",
      "get-active-window.ps1",
      "package.json"
    ]
  }
}
