{
  "name": "wfh-desktop-agent",
  "version": "1.0.0",
  "description": "Work From Home tracking desktop agent",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --portable"
  },
  "dependencies": {
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "electron": "^30.0.1"
  },
  "build": {
    "appId": "com.wfh.desktopagent",
    "productName": "WorkforceOS-Agent",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ]
  }
}
